{
  "manifest_version": 3,
  "name": "AuraLink Yandex Music Companion",
  "description": "Control the Yandex Music tab from the AuraLink Minecraft mod. Never reads passwords or auth tokens.",
  "version": "0.2.0",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:27363/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "AuraLink pairing", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://music.yandex.ru/*", "https://music.yandex.com/*", "https://music.yandex.kz/*"],
      "js": ["page-metadata.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.yandex.ru/*", "https://music.yandex.com/*", "https://music.yandex.kz/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
